24. UNIX System Calls for File Management
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>


int main()
{
    int fd;
    char data[100];


    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);


    if(fd == -1)
    {
        printf("File cannot be opened\n");
        return 1;
    }


    printf("Enter data to write: ");
    fgets(data, sizeof(data), stdin);


    write(fd, data, strlen(data));


    lseek(fd, 0, SEEK_SET);


    printf("\nFile contents:\n");
    int n = read(fd, data, sizeof(data) - 1);
    data[n] = '\0';
    printf("%s", data);


    close(fd);


    printf("\nFile closed successfully\n");


    return 0;
}
