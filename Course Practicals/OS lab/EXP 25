25. UNIX I/O System Calls — fcntl, seek, stat, opendir, readdir
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>


int main()
{
    int fd;
    struct stat st;
    DIR *dir;
    struct dirent *entry;


    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);


    if(fd == -1)
    {
        printf("File cannot be opened\n");
        return 1;
    }


    printf("File opened successfully\n");


    printf("File descriptor: %d\n", fd);


    printf("Current file position: %ld\n", lseek(fd, 0, SEEK_CUR));


    lseek(fd, 10, SEEK_SET);
    printf("File position after seek: %ld\n", lseek(fd, 0, SEEK_CUR));


    if(fstat(fd, &st) == 0)
    {
        printf("File size: %ld bytes\n", st.st_size);
        printf("File permissions: %o\n", st.st_mode & 0777);
    }


    if(fcntl(fd, F_GETFL) != -1)
        printf("fcntl operation successful\n");


    close(fd);


    printf("\nDirectory contents:\n");


    dir = opendir(".");


    if(dir == NULL)
    {
        printf("Directory cannot be opened\n");
        return 1;
    }


    while((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }


    closedir(dir);


    return 0;
}
