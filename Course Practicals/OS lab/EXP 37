37. FCFS Disk Scheduling
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int request[50];
    int n, head;
    int i, total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("\nOrder of servicing:\n");
    printf("%d", head);

    for (i = 0; i < n; i++)
    {
        total += abs(head - request[i]);
        head = request[i];

        printf(" -> %d", request[i]);
    }

    printf("\n\nTotal Head Movement = %d\n", total);

    return 0;
}
