#include <stdio.h>
#include <dirent.h>

int main(int argc, char *argv[])
{
    DIR *dir;
    struct dirent *entry;
    char *path = (argc > 1) ? argv[1] : ".";

    dir = opendir(path);

    if (dir == NULL)
    {
        perror("opendir");
        return 1;
    }

    printf("Contents of %s:\n", path);

    while ((entry = readdir(dir)) != NULL)
    {
        if (entry->d_name[0] != '.')
            printf("%s  ", entry->d_name);
    }

    printf("\n");
    closedir(dir);

    return 0;
}
