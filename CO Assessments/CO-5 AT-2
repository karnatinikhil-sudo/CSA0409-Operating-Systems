QUESTION 5: CPU AND MEMORY RESOURCE MANAGEMENT

PSEUDOCODE:
BEGIN
INPUT application_list
IF application_list IS EMPTY THEN
PRINT "No applications available"
EXIT
ENDIF
FOR EACH app IN application_list DO
CREATE resource_group FOR app
INPUT app.cpu_limit
INPUT app.memory_limit
IF app.cpu_limit <= 0 OR app.memory_limit <= 0 THEN
PRINT "Invalid resource limits for", app
CONTINUE
ENDIF
SET CPU limit FOR app.resource_group
SET memory limit FOR app.resource_group
ASSIGN processes OF app TO app.resource_group
PRINT "Resource limits applied to", app
ENDFOR
WHILE system IS RUNNING DO
FOR EACH app IN application_list DO
cpu_usage = GET_CPU_USAGE(app)
memory_usage = GET_MEMORY_USAGE(app)
IF cpu_usage > app.cpu_limit THEN
THROTTLE CPU USAGE OF app
ENDIF
IF memory_usage > app.memory_limit THEN
LIMIT MEMORY USAGE OF app
ENDIF
ENDFOR
WAIT FOR monitoring_interval
ENDWHILE
END
