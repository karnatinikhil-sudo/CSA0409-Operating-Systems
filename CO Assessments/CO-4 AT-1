Q1. File Allocation Methods (Contiguous / Linked / Indexed)
c
#include <stdio.h>
int r(char*p){int v;printf("%s",p);while(scanf("%d",&v)!=1)while(getchar()!='\n');return v;}
int main(){
 int d[1000],n=r("Disk size: "),k=r("Blocks needed: "),m;printf("1-Contig 2-Linked 3-Indexed: ");m=r("");
 for(int i=0;i<n;i++)d[i]=0;
 if(k<=0||k>n){puts("Insufficient space.");return 0;}
 if(m==1){int s=-1,c=0;for(int i=0;i<n;i++){if(!d[i]){if(!c)s=i;if(++c==k)break;}else c=0;}
  c<k?puts("Failed."):printf("Allocated %d-%d\n",s,s+k-1);}
 else if(m==2||m==3){int a[1000],c=0,st=(m==3);
  for(int i=st;i<n&&c<k;i++)if(!d[i])a[c++]=i;
  if(c<k){puts("Failed.");return 0;}
  if(m==3)printf("Index 0 -> ");else printf("Chain: ");
  for(int i=0;i<c;i++)printf("%d ",a[i]);puts("");}
 else puts("Invalid.");
}

