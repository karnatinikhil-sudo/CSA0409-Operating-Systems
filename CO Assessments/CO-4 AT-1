Q3. Disk Scheduling: FCFS, SSTF, SCAN
c
#include <stdio.h>
#include <string.h>
int r(char*p){int v;printf("%s",p);while(scanf("%d",&v)!=1)while(getchar()!='\n');return v;}
int ad(int a,int b){return a>b?a-b:b-a;}
void srt(int r[],int n){for(int i=0;i<n-1;i++)for(int j=i+1;j<n;j++)if(r[i]>r[j]){int t=r[i];r[i]=r[j];r[j]=t;}}
int fcfs(int q[],int n,int h){int t=0,c=h;printf("FCFS: %d",h);
 for(int i=0;i<n;i++){t+=ad(c,q[i]);c=q[i];printf("->%d",c);}printf("\nSeek=%d\n",t);return t;}
int sstf(int q[],int n,int h){int v[100]={0},t=0,c=h;printf("SSTF: %d",h);
 for(int k=0;k<n;k++){int b=-1,bd=1<<30;for(int i=0;i<n;i++)if(!v[i]&&ad(c,q[i])<bd){bd=ad(c,q[i]);b=i;}
  v[b]=1;t+=bd;c=q[b];printf("->%d",c);}printf("\nSeek=%d\n",t);return t;}
int scn(int q0[],int n,int h,int sz,int dir){int q[100];memcpy(q,q0,n*4);srt(q,n);int t=0,c=h;printf("SCAN: %d",h);
 if(dir){for(int i=0;i<n;i++)if(q[i]>=h){t+=ad(c,q[i]);c=q[i];printf("->%d",c);}
  if(c!=sz-1){t+=ad(c,sz-1);c=sz-1;printf("->%d",c);}
  for(int i=n-1;i>=0;i--)if(q[i]<h){t+=ad(c,q[i]);c=q[i];printf("->%d",c);}}
 else{for(int i=n-1;i>=0;i--)if(q[i]<=h){t+=ad(c,q[i]);c=q[i];printf("->%d",c);}
  if(c){t+=ad(c,0);c=0;printf("->0");}
  for(int i=0;i<n;i++)if(q[i]>h){t+=ad(c,q[i]);c=q[i];printf("->%d",c);}}
 printf("\nSeek=%d\n",t);return t;}
int main(){
 int q[100],n=r("Num requests: "),h,sz,dir;
 for(int i=0;i<n;i++){char b[20];sprintf(b,"Req[%d]: ",i);q[i]=r(b);}
 h=r("Head: ");sz=r("Disk size: ");dir=r("Dir(1up/0down): ");
 int f=fcfs(q,n,h),s=sstf(q,n,h),c=scn(q,n,h,sz,dir);
 printf("FCFS=%d SSTF=%d SCAN=%d\n",f,s,c);
 int b=f;char*nm="FCFS";if(s<b){b=s;nm="SSTF";}if(c<b){b=c;nm="SCAN";}
 printf("Best: %s (%d)\n",nm,b);
}

