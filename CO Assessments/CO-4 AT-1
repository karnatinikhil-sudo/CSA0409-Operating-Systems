Q4. Disk Scheduling: C-SCAN, LOOK
c
#include <stdio.h>
#include <string.h>
int r(char*p){int v;printf("%s",p);while(scanf("%d",&v)!=1)while(getchar()!='\n');return v;}
int ad(int a,int b){return a>b?a-b:b-a;}
void srt(int r[],int n){for(int i=0;i<n-1;i++)for(int j=i+1;j<n;j++)if(r[i]>r[j]){int t=r[i];r[i]=r[j];r[j]=t;}}
int csc(int q0[],int n,int h,int sz){int q[100];memcpy(q,q0,n*4);srt(q,n);int t=0,c=h;printf("C-SCAN: %d",h);
 for(int i=0;i<n;i++)if(q[i]>=h){t+=ad(c,q[i]);c=q[i];printf("->%d",c);}
 if(c!=sz-1){t+=ad(c,sz-1);c=sz-1;printf("->%d",c);}
 c=0;printf("->0");
 for(int i=0;i<n;i++)if(q[i]<h){t+=ad(c,q[i]);c=q[i];printf("->%d",c);}
 printf("\nMove=%d\n",t);return t;}
int lok(int q0[],int n,int h,int dir){int q[100];memcpy(q,q0,n*4);srt(q,n);int t=0,c=h;printf("LOOK: %d",h);
 if(dir){for(int i=0;i<n;i++)if(q[i]>=h){t+=ad(c,q[i]);c=q[i];printf("->%d",c);}
  for(int i=n-1;i>=0;i--)if(q[i]<h){t+=ad(c,q[i]);c=q[i];printf("->%d",c);}}
 else{for(int i=n-1;i>=0;i--)if(q[i]<=h){t+=ad(c,q[i]);c=q[i];printf("->%d",c);}
  for(int i=0;i<n;i++)if(q[i]>h){t+=ad(c,q[i]);c=q[i];printf("->%d",c);}}
 printf("\nMove=%d\n",t);return t;}
int main(){
 int q[100],n=r("Num requests: "),h,sz,dir;
 for(int i=0;i<n;i++){char b[20];sprintf(b,"Req[%d]: ",i);q[i]=r(b);}
 h=r("Head: ");sz=r("Disk size: ");dir=r("Dir(1up/0down): ");
 int c=csc(q,n,h,sz),l=lok(q,n,h,dir);
 printf("C-SCAN=%d LOOK=%d\n%s better.\n",c,l,l<c?"LOOK":c<l?"C-SCAN":"Both equal");
}

