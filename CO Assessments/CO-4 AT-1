#include <stdio.h>
int r(char*p){int v;printf("%s",p);while(scanf("%d",&v)!=1)while(getchar()!='\n');return v;}
int main(){
 int b[1000],n=r("Disk size: "),ch;for(int i=0;i<n;i++)b[i]=0;
 do{printf("1-Alloc 2-Free 3-Show 4-Exit: ");ch=r("");
  if(ch==1){int k=r("Blocks needed: "),f[1000],c=0;
   for(int i=0;i<n&&c<k;i++)if(!b[i])f[c++]=i;
   if(c<k)printf("Only %d free.\n",c);
   else{for(int i=0;i<c;i++)b[f[i]]=1;printf("Allocated: ");for(int i=0;i<c;i++)printf("%d ",f[i]);puts("");}}
  else if(ch==2){int x=r("Block to free: ");
   if(x<0||x>=n)puts("Invalid.");else{b[x]=0;printf("Freed %d.\n",x);}}
  else if(ch==3){int f=0;for(int i=0;i<n;i++){printf("%d",b[i]);if(!b[i])f++;}printf("\nFree: %d/%d\n",f,n);}
 }while(ch!=4);
}

